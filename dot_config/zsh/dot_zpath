# Single source of truth for PATH precedence.
#
# Sourced twice: from .zshenv, which covers every shell, and again from
# .zprofile. Login shells run /etc/zprofile, which re-runs path_helper;
# path_helper rebuilds PATH from /etc/paths and appends whatever was already
# there, demoting everything set here. The second pass restores the order.
#
# typeset -U keeps that second pass idempotent.

path=(
    $HOME/.bin(N-/)
    $HOME/.local/bin(N-/)
    $HOME/.local/share/mise/shims(N-/)
    $HOME/Library/pnpm(N-/)
    /opt/homebrew/bin(N-/)
    /opt/homebrew/sbin(N-/)
    $path
)

typeset -U path
