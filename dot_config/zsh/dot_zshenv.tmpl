export GOPATH="$HOME/Dev/go"
export LC_CTYPE="en_US.UTF-8"

export RIPGREP_CONFIG_PATH=~/.rgconfig

{{- if eq .chezmoi.hostname "Nurula" }}
export GITHUB_TOKEN="{{ pass "github-token" }}"
export DO_SPACES_ID="{{ pass "do-spaces-id" }}"
export DO_SPACES_SECRET="{{ pass "do-spaces-secret" }}"
{{- end }}

if [[ -x /usr/libexec/path_helper ]] ; then
    eval `/usr/libexec/path_helper -s`
fi

export PNPM_HOME="$HOME/Library/pnpm"
[[ -r $ZDOTDIR/.zpath ]] && source $ZDOTDIR/.zpath

{{- if eq .chezmoi.os "darwin" }}
export HOMEBREW_PREFIX=/opt/homebrew
export HOMEBREW_CELLAR=/opt/homebrew/Cellar
export HOMEBREW_REPOSITORY=/opt/homebrew
export INFOPATH="/opt/homebrew/share/info:${INFOPATH:-}"

export SHELL_SESSIONS_DISABLE=1
export SSL_CERT_FILE=/opt/homebrew/etc/ca-certificates/cert.pem
export WEB_CONCURRENCY=0

# Repair fpath after a Homebrew zsh upgrade. FPATH is exported, so a
# long-running process (terminal, tmux) can hand new shells a stale value
# pointing at a now-deleted /opt/homebrew/Cellar/zsh/<old-version>/functions.
# That breaks compinit, add-zsh-hook, colors, is-at-least, etc. Anchor to the
# version-independent core dir and drop any entries that no longer exist.
if [[ -d /opt/homebrew/share/zsh/functions ]] ; then
    fpath=( /opt/homebrew/share/zsh/{site-functions,functions} ${^fpath}(N-/) )
    typeset -U fpath
fi
{{- end }}

export MISE_TRUSTED_CONFIG_PATHS="$HOME/Dev/projects:$HOME/Dev/gems:$HOME/Dev/anyone"
